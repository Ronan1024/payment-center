        <common-auth.version>1.0.0</common-auth.version>
        <database-spring.version>1.1.0</database-spring.version>
        <common.version>1.0.0</common.version>
        <distributed-id.version>1.0.0</distributed-id.version>
        <saas-common.version>1.0.3</saas-common.version>
        <payment-center-api.version>1.0.0</payment-center-api.version>
        <web-framework.version>1.1.0</web-framework.version>
        <saas-common-web.version>1.0.3</saas-common-web.version>
        <mysql.version>8.0.33</mysql.version>
