            <dependency>
                <groupId>com.baosight.utils</groupId>
                <artifactId>common-util-validation</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.baosight.distributedid</groupId>
                <artifactId>distributed-id-spring-boot-starter</artifactId>
                <version>${distributed-id.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ronan.common</groupId>
                <artifactId>common-all</artifactId>
                <version>${common.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baosight.saas</groupId>
                <artifactId>saas-common-dependencies</artifactId>
                <version>${saas-common.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baosight.payment</groupId>
                <artifactId>payment-center-api</artifactId>
                <version>${payment-center-api.version}</version>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baosight.web.framework</groupId>
                <artifactId>web-spring-boot-dependencies</artifactId>
                <version>${web-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring</artifactId>
                <version>3.5.15</version>
